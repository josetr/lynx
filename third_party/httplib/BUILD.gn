source_set("httplib") {
  sources = [
    "httplib.cc",
    "httplib.h",
  ]

  if (is_linux) {
    libs = [ "anl" ]
  } else if (is_mac) {
    frameworks = [
      "CFNetwork.framework",
    ]
  }

  defines = [ "CPPHTTPLIB_NO_EXCEPTIONS" ]
}
